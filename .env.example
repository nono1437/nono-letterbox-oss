# Copy this file to .env for local development.
# Never commit the real .env file.

# Optional owner allowlist used only after verified server-side authentication.
OWNER_EMAIL=you@example.com

# Public-edition application identity.
VITE_APP_NAME=Nono Letterbox OSS
VITE_APP_MODE=demo

# Provider credentials and tokens must be stored in local environment variables
# or encrypted repository secrets. Do not prefix secrets with VITE_, because
# Vite exposes VITE_* values to browser code.
